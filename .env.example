# Variables for compose.yaml. Do not copy by hand: `scripts/dev-env.sh` writes .env with random
# secrets (chmod 600). .env is gitignored; this file holds placeholders only.
DB_NAME=dx03v2
DB_USER=dx03v2
DB_PASSWORD=<generated-by-scripts/dev-env.sh>
ADMIN_TOKEN=<generated-by-scripts/dev-env.sh-48-characters>
WEB_PORT=8080
RATE_LIMIT_WRITE_PER_MINUTE=10
GIT_SHA=unknown
