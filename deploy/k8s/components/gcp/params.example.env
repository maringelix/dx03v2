# Deploy-time values for the gcp overlays (KEY=VALUE, no quotes). scripts/deploy-gcp.sh writes the
# real params.env from the Parameter Manager parameter tx03v2-lab-contract (docs/CONTRATO.md) into a
# temporary copy of deploy/k8s; CI renders and validates the overlays with this example file.
# Placeholders only: the example project, an all-zero commit SHA and the example values of the
# tx03v2 tests (terraform/envs/lab/tests/lab.tftest.hcl). LB_SOURCE_RANGES is fixed by the contract.
API_IMAGE=us-central1-docker.pkg.dev/tx03v2-lab-example/dx03v2/api:0000000000000000000000000000000000000000
MESH_IMAGE=us-central1-docker.pkg.dev/tx03v2-lab-example/dx03v2/api:0000000000000000000000000000000000000000
WEB_IMAGE=us-central1-docker.pkg.dev/tx03v2-lab-example/dx03v2/web:0000000000000000000000000000000000000000
GATEWAY_ADDRESS_NAME=tx03v2-lab-gateway
WAF_SECURITY_POLICY=tx03v2-lab-waf
LB_SOURCE_RANGES=35.191.0.0/16,130.211.0.0/22
DB_ENDPOINT_IP=10.30.0.5
# Public edge of the profile full (contract keys dns/hostname and dns/certificate-map): `disabled` for core.
DNS_HOSTNAME=lab.example.com
CERT_MAP=tx03v2-lab-app
