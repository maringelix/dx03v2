# Deploy-time values for the local-platform overlay (KEY=VALUE, no quotes). scripts/deploy-local.sh
# writes the real params.env from the ConfigMap lab-system/lab-contract of the tx03v2 local lab; CI
# renders and validates the overlay with this example file (an all-zero commit SHA).
API_IMAGE=registry.tx03v2.local/dx03v2/api:0000000000000000000000000000000000000000
WEB_IMAGE=registry.tx03v2.local/dx03v2/web:0000000000000000000000000000000000000000
NETWORK_CIDR=10.252.0.0/24
DB_ENDPOINT_CIDR=10.252.0.11/32
