// Linux environment for the harness (Windows and macOS contributors): Node.js 24 (.nvmrc) plus
// Docker-in-Docker for the image builds, compose and the kind e2e. `make tools` installs the pinned
// tools into .tools/ on creation; then run `make verify`.
{
  "name": "dx03v2",
  // mcr.microsoft.com/devcontainers/javascript-node:24-trixie, pinned by digest (verified 2026-10-10)
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-trixie@sha256:7e6eff9f0cac7f1d4d1836a7bd2a9011d8ea244fceb155261705be483218ea18",
  "features": {
    // docker-in-docker 2.17.0, pinned by digest (verified 2026-10-10)
    "ghcr.io/devcontainers/features/docker-in-docker@sha256:25b9f05705ffba7dbe503230ac76081419306f8c8bc88e0ce78c4ecd99a0c78c": {}
  },
  "postCreateCommand": "make tools",
  "remoteEnv": {
    "HARNESS_STRICT": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "timonwong.shellcheck",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig"
      ]
    }
  }
}
