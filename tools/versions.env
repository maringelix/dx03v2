# Harness tool versions (verified 2026-10-11).
# Change a version only with scripts/update-tool-checksums.sh <tool> <version>,
# which also rewrites tools/checksums.txt. See docs/SUSTENTACAO.md.
# kubectl follows the Kubernetes minor of the kind node image (kind/kind-config.yaml) and of the
# GKE Autopilot cluster in tx03v2 (1.36, Regular release channel).
TRIVY_VERSION=0.75.0
HADOLINT_VERSION=2.15.1
ACTIONLINT_VERSION=1.7.12
SHELLCHECK_VERSION=0.11.0
KUBECONFORM_VERSION=0.8.0
GITLEAKS_VERSION=8.30.1
KIND_VERSION=0.33.0
KUBECTL_VERSION=1.36.5
