{
  // Emits dist/ from src/ only (tests and config stay out of the image).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src"]
}
